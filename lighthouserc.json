{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": [
          "--no-sandbox",
          "--disable-gpu",
          "--headless",
          "--user-data-dir=./.lighthouseci/userData"
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}