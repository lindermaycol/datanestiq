---
// TrustLayer.astro
const { 
  heading = 'Tecnologías que dominamos',
  logos = [
    { src: 'ph-cloud', alt: 'AWS' },
    { src: 'ph-database', alt: 'Databricks' },
    { src: 'ph-snowflake', alt: 'Snowflake' },
    { src: 'ph-file-code', alt: 'Python', class: 'hidden md:block' },
    { src: 'ph-docker-logo', alt: 'Kubernetes', class: 'hidden lg:block' }
  ],
  testimonialQuote = null,
  testimonialAuthor = null,
  testimonialRole = null,
  testimonialLabel = null
} = Astro.props;
---
<section class="py-20 border-y border-white/10 bg-black/30 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-widest" data-animate="fade-up" style="opacity: 0">
        {heading}
      </h3>
    </div>
    
    <!-- Tech Stack Logos -->
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-60">
      {logos.map(logo => (
        <div class={`text-xl font-bold font-serif ${logo.class || ''}`} data-animate="stagger-up" style="opacity: 0">
          <i class={`ph ${logo.src}`}></i> {logo.alt}
        </div>
      ))}
    </div>

    <!-- Testimonial (solo se renderiza con una cita REAL; retirado hasta tener casos verificables) -->
    {testimonialQuote && (
      <div class="mt-20 max-w-4xl mx-auto text-center" data-animate="fade-up" style="opacity: 0">
        <div class="text-brandCyan mb-6 text-4xl">"</div>
        <p class="text-2xl md:text-3xl font-light italic leading-relaxed text-gray-200">
          {testimonialQuote}
        </p>
        <div class="mt-8 flex items-center justify-center gap-4">
          <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center text-xl font-bold border border-brand/30">
            {testimonialLabel}
          </div>
          <div class="text-left">
            <h4 class="font-bold text-white">{testimonialAuthor}</h4>
            <p class="text-sm text-gray-400">{testimonialRole}</p>
          </div>
        </div>
      </div>
    )}
  </div>
</section>
