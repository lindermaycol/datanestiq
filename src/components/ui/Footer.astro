---
import corpus from '../../data/taxonomyCorpus.json';
import sectorsCorpus from '../../data/sectorsCorpus.json';
---
<footer class="bg-surface py-12 border-t border-white/10 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
      <div class="col-span-1 md:col-span-1">
        <h3 class="text-xl font-bold text-white mb-4">DATANESTIQ</h3>
        <p class="text-gray-400">Ingeniería de Datos e Inteligencia Artificial de Élite para corporaciones y entidades públicas.</p>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">Servicios</h4>
        <ul class="space-y-2 text-gray-400">
          {corpus.map(service => (
            <li><a href={`/soluciones/${service.slug}`} class="hover:text-brand transition-colors">{service.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">Sectores</h4>
        <ul class="space-y-2 text-gray-400">
          {sectorsCorpus.map(sector => (
            <li><a href={`/sectores/${sector.slug}`} class="hover:text-brand transition-colors">{sector.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">Empresa</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/nosotros" class="hover:text-brand transition-colors">Nosotros</a></li>
          <li><a href="/casos-de-exito" class="hover:text-brand transition-colors">Casos de Éxito</a></li>
          <li><a href="/blog" class="hover:text-brand transition-colors">Blog</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">Legal</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/privacidad" class="hover:text-brand transition-colors">Privacidad</a></li>
          <li><a href="/terminos" class="hover:text-brand transition-colors">Términos</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 mt-12 pt-8 text-center text-gray-400">
      <p>&copy; {new Date().getFullYear()} Datanestiq. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
