---
// IllustrativeRoiCase.astro
const { 
  title,
  description,
  metrics = [],
  context = ''
} = Astro.props;
---
<div class="glass-card p-6 border-l-4 border-yellow-500/50 hover:border-yellow-500 transition-colors relative mt-4">
  <div class="absolute top-0 right-0 bg-yellow-500/10 text-yellow-500 text-xs font-bold px-3 py-1 rounded-bl-lg rounded-tr-lg flex items-center group cursor-help z-20">
    <i class="ph ph-warning-circle mr-1"></i> [EST] Escenario Ilustrativo
    <div class="absolute hidden group-hover:block w-64 bg-surface border border-white/10 p-3 rounded-lg shadow-xl top-8 right-0 text-gray-300 text-xs z-30 normal-case font-normal text-left">
      Esta proyección es un modelo basado en promedios de la industria y nuestras capacidades arquitectónicas, no representa un cliente real histórico. Datanestiq prioriza la transparencia.
    </div>
  </div>
  
  <h3 class="text-xl font-bold text-white mb-2 pr-40">{title}</h3>
  
  {context && (
    <p class="text-gray-400 text-sm mb-4"><span class="font-semibold text-gray-300">Contexto:</span> {context}</p>
  )}
  
  <p class="text-gray-300 mb-6">{description}</p>
  
  {metrics.length > 0 && (
    <div class="grid grid-cols-2 gap-4">
      {metrics.map((m: any) => (
        <div class="bg-white/5 rounded-lg p-4">
          <div class="text-2xl font-bold text-brandCyan mb-1">{m.value}</div>
          <div class="text-xs text-gray-400 uppercase tracking-wider">{m.label}</div>
        </div>
      ))}
    </div>
  )}
</div>
