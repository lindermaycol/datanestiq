---
// Services.astro
const { 
  heading = 'Nuestros Pilares de Expertise',
  subheading = 'Dominamos el ciclo de vida completo de la información para catapultar el rendimiento de tu corporación.'
} = Astro.props;
---
<section id="servicios" class="py-24 bg-surface relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-4">{heading}</h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">{subheading}</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Service 1 -->
      <a href="/soluciones/ai-data-science" class="glass-card hover:-translate-y-2 block service-card transition-all duration-500" data-service-id="ai-data-science" data-animate="fade-up" style="opacity: 0">
        <div class="w-12 h-12 bg-brand/20 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">AI & Data Science</h3>
        <p class="text-gray-400">Modelos predictivos, Machine Learning y arquitecturas GenAI privadas.</p>
      </a>

      <!-- Service 2 -->
      <a href="/soluciones/data-engineering" class="glass-card hover:-translate-y-2 block service-card transition-all duration-500" data-service-id="data-engineering" data-animate="fade-up" style="opacity: 0">
        <div class="w-12 h-12 bg-brandCyan/20 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-brandCyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Data Engineering</h3>
        <p class="text-gray-400">Data Lakes, procesamiento distribuido y pipelines ETL escalables.</p>
      </a>

      <!-- Service 3 -->
      <a href="/soluciones/business-intelligence" class="glass-card hover:-translate-y-2 block service-card transition-all duration-500" data-service-id="business-intelligence" data-animate="fade-up" style="opacity: 0">
        <div class="w-12 h-12 bg-secondary/20 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Business Intelligence</h3>
        <p class="text-gray-400">Dashboards ejecutivos de alto rendimiento y Process Mining.</p>
      </a>

      <!-- Service 4 -->
      <a href="/soluciones/sistemas-digitales" class="glass-card hover:-translate-y-2 block service-card transition-all duration-500" data-service-id="sistemas-digitales" data-animate="fade-up" style="opacity: 0">
        <div class="w-12 h-12 bg-cyan-500/20 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Sistemas Digitales Premium</h3>
        <p class="text-gray-400">Plataformas corporativas AI-first, portales B2B y arquitecturas headless a medida.</p>
      </a>

      <!-- Service 5 -->
      <a href="/soluciones/hiperautomatizacion" class="glass-card hover:-translate-y-2 block service-card transition-all duration-500" data-service-id="hiperautomatizacion" data-animate="fade-up" style="opacity: 0">
        <div class="w-12 h-12 bg-pink-500/20 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Hiperautomatización Inteligente</h3>
        <p class="text-gray-400">RPA + IA cognitiva para ejecutar procesos críticos de extremo a extremo, sin fricción.</p>
      </a>

      <!-- Service 6 -->
      <a href="/soluciones/estrategia-datos-ia" class="glass-card hover:-translate-y-2 block service-card transition-all duration-500" data-service-id="estrategia-datos-ia" data-animate="fade-up" style="opacity: 0">
        <div class="w-12 h-12 bg-amber-500/20 rounded-lg flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Consultoría Estratégica en Datos & IA</h3>
        <p class="text-gray-400">Auditoría de madurez, roadmaps de alto ROI y gobernanza de IA para tu directorio.</p>
      </a>
    </div>
  </div>
</section>
