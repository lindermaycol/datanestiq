---
interface Props {
  headline: string;
  subheadline: string;
  serviceId: string;
}
const { headline, subheadline, serviceId } = Astro.props;
---
<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-surface">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-8">
      {headline}
    </h1>
    <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-300 mb-10">
      {subheadline}
    </p>
    <div class="flex justify-center gap-4">
      <a href={`/?servicio=${serviceId}`} class="btn-primary text-lg inline-block">Inicia tu Diagnóstico</a>
    </div>
  </div>
</section>
