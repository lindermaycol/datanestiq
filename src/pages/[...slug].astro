---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/ui/Navbar.astro';
import Footer from '../components/ui/Footer.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ id, data }) => {
    if (id === 'home') return false;
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  return pages.map(page => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout 
  title={page.data.seo.title} 
  description={page.data.seo.description}
>
  <Navbar />
  
  <main class="pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {page.data.draft && (
        <div class="bg-yellow-500/20 border border-yellow-500 text-yellow-200 px-4 py-2 rounded mb-8 text-center text-sm font-bold uppercase tracking-widest">
          Modo Borrador (Draft)
        </div>
      )}
      
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold mb-6 text-white">
          {page.data.hero.headline}
        </h1>
        <p class="text-xl text-gray-300">
          {page.data.hero.subheadline}
        </p>
        {page.data.hero.cta && (
          <div class="mt-8">
            <a href="/contacto" class="inline-block bg-brandCyan text-black font-bold px-8 py-3 rounded hover:bg-cyan-400 transition-colors">
              {page.data.hero.cta}
            </a>
          </div>
        )}
      </div>

      <div class="space-y-12">
        {page.data.sections.map(section => (
          <section class="glass-card p-8 border-l-4 border-l-brandCyan">
            <h2 class="text-2xl font-bold mb-4 text-white">{section.heading}</h2>
            <p class="text-gray-300 whitespace-pre-wrap leading-relaxed">{section.body}</p>
            {section.items && section.items.length > 0 && (
              <ul class="mt-6 space-y-3">
                {section.items.map(item => (
                  <li class="flex items-start">
                    <i class="ph ph-check-circle text-brandCyan mt-1 mr-3 text-lg"></i>
                    <span class="text-gray-300">{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
      
      <div class="prose prose-invert prose-cyan max-w-none mt-16 p-8 glass-card">
        <Content />
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
