---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/ui/Navbar.astro';
import Footer from '../../components/ui/Footer.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => {
    return data.draft !== true;
  });
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description,
  "datePublished": entry.data.pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": entry.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Datanestiq",
    "logo": {
      "@type": "ImageObject",
      "url": "https://datanestiq.com/logo.png"
    }
  }
};
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <Navbar />
  
  <main class="pt-32 pb-20 max-w-4xl mx-auto px-4">
    <article class="prose prose-invert prose-lg max-w-none">
      <header class="mb-12 border-b border-white/10 pb-8">
        <div class="flex items-center gap-4 text-sm text-brand mb-4">
          <span>{entry.data.author}</span>
          <span>•</span>
          <time>{entry.data.pubDate.toISOString().split('T')[0]}</time>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 leading-tight">{entry.data.title}</h1>
        <p class="text-xl text-gray-400">{entry.data.description}</p>
        
        <div class="flex gap-2 mt-6">
          {entry.data.tags.map(tag => (
            <span class="px-3 py-1 bg-white/5 rounded-full text-sm text-gray-300">#{tag}</span>
          ))}
        </div>
      </header>
      
      <div class="glass-card p-8 bg-surface/50">
        <Content />
      </div>

      <div class="mt-16 text-center glass-card p-8">
        <h3 class="text-2xl font-bold text-white mb-4">¿Listo para escalar tus operaciones?</h3>
        <p class="text-gray-400 mb-6">Interactúa con nuestro sistema experto y descubre la madurez de tu infraestructura de IA y datos.</p>
        <button onclick="document.dispatchEvent(new CustomEvent('open-chatbot'))" class="bg-brand text-background px-8 py-3 rounded font-semibold hover:bg-brand/90 transition-colors inline-flex items-center gap-2">
          Inicia tu Diagnóstico
        </button>
      </div>
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Footer />
</BaseLayout>
