---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/ui/Navbar.astro';
import Footer from '../../components/ui/Footer.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog Corporativo | Datanestiq" description="Artículos, análisis y perspectivas sobre Inteligencia Artificial y Datos para líderes corporativos.">
  <Navbar />
  
  <main class="pt-32 pb-20 max-w-7xl mx-auto px-4 relative z-10">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Perspectivas C-Level</h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">Análisis estratégico sobre Data Mesh, IA Generativa y automatización para líderes que transforman industrias.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allPosts.map(post => (
        <a href={`/blog/${post.id}`} class="glass-card p-6 block hover:-translate-y-1 transition-transform">
          <time class="text-brand text-sm mb-2 block">{post.data.pubDate.toISOString().split('T')[0]}</time>
          <h2 class="text-2xl font-bold text-white mb-3 leading-tight">{post.data.title}</h2>
          <p class="text-gray-400 mb-4 line-clamp-3">{post.data.description}</p>
          <div class="flex flex-wrap gap-2 mt-auto">
            {post.data.tags.map(tag => (
              <span class="px-2 py-1 bg-white/5 rounded text-xs text-gray-300">#{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>
