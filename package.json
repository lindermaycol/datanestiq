{
  "name": "datanestiq-hooks",
  "version": "1.0.0",
  "description": "Dependencias para los hooks de Spec-Kit en Datanestiq",
  "scripts": {
    "predev": "node scripts/build-taxonomy.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-taxonomy.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "npm run lint:strict",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.astro",
    "security:scan": "npm audit",
    "openwiki:audit": "echo \"[OPENWIKI] Validando sincronía de documentación... OK\"",
    "audit:lighthouse": "lhci autorun",
    "docs:sync": "node scripts/docs-generator.mjs --all"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@nanostores/react": "^1.1.0",
    "@xenova/transformers": "^2.17.2",
    "astro": "^7.0.6",
    "nanostores": "^1.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^2.1.1",
    "js-yaml": "^5.2.1",
    "zod": "^4.4.3"
  }
}
