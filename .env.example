IONOS_SSH_HOST=access-xxx.webspace-host.com
IONOS_SSH_USER=user
# Autenticación: preferir CLAVE (el password quedó comprometido en git; ver planes/DESPLIEGUE-IONOS.md)
IONOS_SSH_KEY_PATH=/ruta/a/clave_privada_ionos
IONOS_SSH_PASSWORD=your_password
IONOS_REMOTE_PATH=/kunden/homepages/.../htdocs
# Panel CRM interno (Spec 014): hash bcrypt + IPs permitidas
ADMIN_PASSWORD_HASH=genera_con_password_hash_bcrypt
ALLOWED_IPS=127.0.0.1,::1

# AI Provider Keys
GROQ_API_KEY=your_groq_api_key_here

# Tier económico (OpenAI-compatible). Elige UN proveedor:
# --- Opción A: DeepSeek ---
CHEAP_LLM_URL=https://api.deepseek.com/v1/chat/completions
CHEAP_LLM_KEY=your_cheap_api_key_here
CHEAP_LLM_MODEL=deepseek-chat
# --- Opción B: Alibaba Qwen (DashScope) — descomenta para usar ---
# CHEAP_LLM_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
# CHEAP_LLM_KEY=your_dashscope_api_key_here
# CHEAP_LLM_MODEL=qwen-plus

# --- Configuración OpenWiki (Balancer Groq ⇄ DashScope ⇄ Gemini) ---
# El motor reparte la carga (round-robin ponderado) entre los proveedores que
# tengan clave y peso > 0. Poner un peso en 0 desactiva ese proveedor.
GROQ_MODEL=llama-3.3-70b-versatile
LLM_WEIGHT_GROQ=1
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_MODEL=qwen-plus
LLM_WEIGHT_DASHSCOPE=1
# Google Gemini (capa OpenAI-compatible de la Generative Language API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-2.5-flash
LLM_WEIGHT_GEMINI=1

# Governance and Cost Limits
# Máximo número de peticiones LLM por día permitidas
DAILY_CALL_CAP=5000
# Máximo número de tokens LLM por día permitidos
DAILY_TOKEN_CAP=2000000
# Número de llamadas en menos de 3 minutos para detonar alerta
BURST_THRESHOLD=15
# Webhook opcional para alertamiento en Slack/Discord (vacio = deshabilitado)
ALERT_WEBHOOK_URL=
