name: Agent Factory Pipeline

on:
  push:
    branches:
      - main
    paths:
      - 'specs/003-taxonomia-servicios/**'
      - 'prompts/**'
      - 'backend/langgraph_pipeline.py'
  workflow_dispatch:
    inputs:
      client_profile:
        description: 'Client Profile (e.g. C-Level)'
        required: true
        default: 'C-Level'
      target_sector:
        description: 'Target Sector from Spec 003'
        required: true

jobs:
  run-pipeline:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f backend/requirements.txt ]; then pip install -r backend/requirements.txt; fi

      - name: Run LangGraph Pipeline
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          # Pipeline execution that outputs generated markdown or JSON
          python backend/langgraph_pipeline.py --mode=ci
          
      - name: Commit and Push Generated Copy
        uses: stefanzweifel/git-auto-commit-action@v4
        with:
          commit_message: "chore(agents): Auto-generated copy from LangGraph pipeline"
          file_pattern: 'docs/generated_copy/*.md index.html'
