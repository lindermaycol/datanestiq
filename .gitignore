# Archivos del núcleo de WordPress
wp-admin/
wp-includes/
*.php
!wp-config-sample.php
# App PHP propio (NO core WordPress): API, panel CRM interno y scripts. No contienen secretos (leen de .env).
!public/api/*.php
!public/admin/*.php
!scripts/*.php
# wp-config.php ignorado (contiene credenciales de BD; openwiki respeta .gitignore y ya no lo escanea)

# Ignorar todo wp-content pero incluir temas y plugins específicos si es necesario
wp-content/*
!wp-content/themes/
!wp-content/plugins/
!wp-content/mu-plugins/

# Ignorar uploads (imágenes, media) ya que suelen ser pesados y se sincronizan vía backup
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/backup-db/

# Archivos de entorno y volcados locales
.env
*.sql
*.tar.gz
*.zip
remote_extract.py
local_setup.ps1
srdb/

# PII y logs (NO exponer; además openwiki respeta .gitignore, así los excluye del escaneo)
secure_leads/
*.jsonl

# Spec Kit / Antigravity agent credentials (security)
.agents/*
!.agents/skills/
.agents/skills/**/secrets/
node_modules
node_modules
dist/
.astro/

# Basura y temporales
.venv/
appjs_extract.txt
appjs_lines.txt
appjs_lines2.txt
indexhtml_extract.txt
indexhtml_lines.txt
openwiki-log.txt
conversation_history/
msg.txt
transcript_extract.txt
